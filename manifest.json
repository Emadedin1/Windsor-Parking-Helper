{
  "manifest_version": 3,
  "name": "Windsor Parking Helper",
  "version": "1.0.0",
  "description": "Find nearby public parking options in Windsor, Ontario.",
  "action": {
    "default_popup": "index.html",
    "default_title": "Windsor Parking Helper"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "contextMenus"],
  "icons": {
    "16": "icons/icon16.svg",
    "48": "icons/icon48.svg",
    "128": "icons/icon128.svg"
  }
}